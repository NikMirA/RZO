#include <iostream>
#include <opencv2/opencv.hpp>
#include <opencv2/imgproc.hpp>
#include <opencv2/highgui.hpp>
#include <opencv2/objdetect.hpp>

using namespace std;
using namespace cv;

int main() {
    // КАСКАДЫ
    CascadeClassifier faceCascade;
    CascadeClassifier eyeCascade;
    CascadeClassifier smileCascade;

    if (!faceCascade.load("haarcascade_frontalface_default.xml")) {
        cout << "Error: cannot load face cascade!" << endl;
        cout << "Make sure haarcascade_frontalface_default.xml is in the project folder." << endl;
        return -1;
    }
    cout << "Face cascade loaded." << endl;

    if (!eyeCascade.load("haarcascade_eye.xml")) {
        cout << "Error: cannot load eye cascade!" << endl;
        return -1;
    }
    cout << "Eye cascade loaded." << endl;

    if (!smileCascade.load("haarcascade_smile.xml")) {
        cout << "Warning: cannot load smile cascade (will continue without it)" << endl;
    }
    else {
        cout << "Smile cascade loaded." << endl;
    }

    string videoPath = "lab6.mp4";
    VideoCapture cap(videoPath);

    if (!cap.isOpened()) {
        cout << "Error: cannot open video!" << endl;
        cout << "Path: " << videoPath << endl;
        cout << "Press Enter to exit...";
        cin.get();
        return -1;
    }

    double fps = cap.get(CAP_PROP_FPS);
    cout << "\nVideo opened. FPS: " << fps << endl;
    cout << "\nControls: ESC = exit\n" << endl;

    Mat frame, gray;
    int frameCount = 0;
    int savedCount = 0;

    while (cap.read(frame)) {
        if (frame.empty()) break;

        frameCount++;
        double startTime = (double)getTickCount();

        cvtColor(frame, gray, COLOR_BGR2GRAY);
        equalizeHist(gray, gray);  // Выравнивание гистограммы (улучшает детекцию)

        // Поиск лиц
        vector<Rect> faces;
        faceCascade.detectMultiScale(gray, faces,
            1.1,    // scaleFactor — шаг масштабирования
            5,      // minNeighbors — фильтр ложных срабатываний
            0,      // flags
            Size(50, 50)  // minSize — минимальный размер лица
        );

        for (auto& face : faces) {
            // Рисуем лицо (зелёный прямоугольник)
            rectangle(frame, face, Scalar(0, 255, 0), 2);

            //  ROI лица для поиска глаз и улыбки
            Mat faceROI = gray(face);

            // Поиск глаз внутри лица 
            vector<Rect> eyes;
            eyeCascade.detectMultiScale(faceROI, eyes,
                1.2,    // scaleFactor
                8,      // minNeighbors (выше = меньше ложных)
                0,
                Size(20, 20),                           // min
                Size(face.width / 3, face.height / 3)   // max
            );

            // глаза (верхняя половина лица)
            vector<Rect> eyesFiltered;
            for (auto& eye : eyes) {
                int eyeCenterY = eye.y + eye.height / 2;
                if (eyeCenterY < face.height / 2) {
                    eyesFiltered.push_back(eye);
                }
            }

            if (eyesFiltered.size() > 2) {
                sort(eyesFiltered.begin(), eyesFiltered.end(),
                    [](const Rect& a, const Rect& b) { return a.area() > b.area(); });
                eyesFiltered.resize(2);
            }

            // глаза (синие круги)
            for (auto& eye : eyesFiltered) {
                Point center(face.x + eye.x + eye.width / 2,
                    face.y + eye.y + eye.height / 2);
                int radius = (eye.width + eye.height) / 4;
                circle(frame, center, radius, Scalar(255, 0, 0), 2);
            }

            // улыбка внутри лица
            if (!smileCascade.empty()) {
                vector<Rect> smiles;
                smileCascade.detectMultiScale(faceROI, smiles,
                    1.3,    // scaleFactor
                    20,     // minNeighbors 
                    0,
                    Size(25, 20),                        // min
                    Size(face.width / 2, face.height / 3) // max
                );

                // улыбки (нижняя половина лица)
                vector<Rect> smilesFiltered;
                for (auto& smile : smiles) {
                    int smileCenterY = smile.y + smile.height / 2;
                    if (smileCenterY > face.height / 2) {
                        smilesFiltered.push_back(smile);
                    }
                }

                if (smilesFiltered.size() > 1) {
                    sort(smilesFiltered.begin(), smilesFiltered.end(),
                        [](const Rect& a, const Rect& b) { return a.area() > b.area(); });
                    smilesFiltered.resize(1);
                }

                // улыбка (жёлтый прямоугольник)
                for (auto& smile : smilesFiltered) {
                    Rect smileRect(face.x + smile.x, face.y + smile.y,
                        smile.width, smile.height);
                    rectangle(frame, smileRect, Scalar(0, 255, 255), 2);
                }
            }
        }

        // FPS
        double endTime = (double)getTickCount();
        double currentFPS = getTickFrequency() / (endTime - startTime);
        putText(frame, "FPS: " + to_string((int)currentFPS), Point(20, 40),
            FONT_HERSHEY_SIMPLEX, 1.0, Scalar(0, 0, 255), 2);

        namedWindow("Face / Eyes / Smile Detection", WINDOW_NORMAL);
        resizeWindow("Face / Eyes / Smile Detection", 900, 600);
        imshow("Face / Eyes / Smile Detection", frame);

        if (frameCount == 1 || frameCount % 100 == 0) {
            string filename = "result_frame" + to_string(frameCount) + ".jpg";
            imwrite(filename, frame);
            cout << "Saved: " << filename << endl;
            savedCount++;
        }

        if (waitKey(30) == 27) {
            cout << "\nExit by user." << endl;
            break;
        }
    }

    cap.release();
    destroyAllWindows();

    cout << "\nProcessing finished." << endl;
    cout << "Total frames: " << frameCount << endl;
    cout << "Saved frames: " << savedCount << endl;
    cout << "\nPress Enter to exit...";
    cin.get();
    return 0;
}
